{
    "name": "@teilchen/runtime",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "build": "pnpm run clean && rolldown -c",
        "clean": "rimraf dist"
    },
    "sideEffects": false,
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./src/index.ts",
        "./player": "./dist/player.global.js",
        "./dist/*": "./dist/*"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "./player": "./dist/player.global.js"
        }
    },
    "author": "taiyuuki <taiyuuki@qq.com>",
    "license": "MIT",
    "files": [
        "dist"
    ],
    "dependencies": {
        "@teilchen/core": "workspace:*"
    },
    "devDependencies": {
        "@webgpu/types": "catalog:"
    },
    "description": "WebGPU GPU VFX runtime: GPU simulation + indirect billboard rendering + VFXPlayer high-level API",
    "keywords": [
        "webgpu",
        "particles",
        "vfx",
        "gpu",
        "simulation",
        "wallpaper-engine"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/taiyuuki/teilchen.git"
    },
    "bugs": {
        "url": "https://github.com/taiyuuki/teilchen/issues"
    },
    "prepublishOnly": "pnpm build"
}
