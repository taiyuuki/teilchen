{
    "name": "@teilchen/core",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "build": "pnpm run clean && rolldown -c",
        "clean": "rimraf dist"
    },
    "sideEffects": true,
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "author": "taiyuuki <taiyuuki@qq.com>",
    "license": "MIT",
    "files": [
        "dist"
    ],
    "description": "GPU VFX particle system data model + module registry + Wallpaper Engine JSON import/export (graphics-API agnostic)",
    "keywords": [
        "particles",
        "vfx",
        "wallpaper-engine",
        "json",
        "data-model"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/taiyuuki/teilchen.git"
    },
    "bugs": {
        "url": "https://github.com/taiyuuki/teilchen/issues"
    },
    "prepublishOnly": "pnpm build"
}
