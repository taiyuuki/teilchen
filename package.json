{
  "name": "teilchen",
  "private": true,
  "version": "0.0.1",
  "description": "WebGPU GPU VFX runtime & editor.",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "dev:editor": "pnpm --filter editor dev",
    "build": "pnpm --filter @teilchen/core build && pnpm --filter @teilchen/runtime build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json && pnpm --filter editor typecheck"
  },
  "devDependencies": {
    "@taiyuuki/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "@types/web": "catalog:",
    "@webgpu/types": "catalog:",
    "eslint": "catalog:",
    "esno": "catalog:",
    "rimraf": "catalog:",
    "rolldown": "catalog:",
    "rolldown-plugin-dts": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^5.0.1"
  }
}